# Copy to .env for local development. NEVER commit real credentials.
# The GitHub Pages static export (scripts/build-pages.mjs) needs NONE of
# these — it builds without a database and without SMTP.

# Local SQLite database (used by the API routes in development)
DATABASE_URL="file:/path/to/db/custom.db"

# Absolute site URL used by sitemap/feeds/metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Client-side contact-form fallback (Formspark). Public-by-design key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your-formspark-access-key"

# Contact API — SMTP delivery (server-side only, env-only credentials)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
CONTACT_TO=""
